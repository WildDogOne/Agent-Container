#!/bin/sh
# Installed as /usr/local/bin/hermes (see install.sh). Starts Hermes with a
# container-local Hermes home so every container session runs its own gateway.
#
# Hermes runs exactly one gateway daemon per Hermes home: the rendezvous files
# (gateway.lock, gateway.sock, gateway.pid, gateway_state.json) sit at the
# home's root, and clients dial the gateway's loopback TCP endpoint. ~/.hermes
# is bind-mounted into every session, so with two sessions up the second one
# discovers the first container's gateway through the shared control socket and
# then fails to reach its 127.0.0.1 endpoint from a different network
# namespace: "Error: Gateway connection failed; no local fallback".
#
# So: keep only the gateway runtime files per-container (in $HOME/.hermes-session,
# which is not mounted and dies with the container), and symlink everything else
# from the shared host home. Config, secrets, auth, skills, hooks, cron, memories
# and session transcripts stay shared; each container gets its own gateway and its
# own session store (Hermes enforces one writer per state.db) and logs.
# flock-based lockfiles (.env.lock, auth.lock, ...) are shared too, so they still
# coordinate across containers.
#
# installs/ is deliberately NOT symlinked either: it's the per-home dependency
# environment Hermes prepares on first launch and then executes. Symlinking it
# would let a session plant code in the shared ~/.hermes/installs that the host's
# native hermes runs on its next launch - the exact vector the read-only config
# mounts in harness.conf exist for. Each container instead prepares its own
# installs/ inside the session home (container-local, discarded on exit); the
# cost is a dependency re-download per session.
set -eu

shared="${HERMES_SHARED_HOME:-$HOME/.hermes}"
home="${HERMES_SESSION_HOME:-$HOME/.hermes-session}"

mkdir -p "$home"
chmod 700 "$home"

for p in "$shared"/* "$shared"/.[!.]*; do
    [ -e "$p" ] || continue
    name="${p##*/}"
    case "$name" in
        gateway.lock|gateway.pid|gateway.sock|gateway.sock.path|gateway_state.json|gateway-starts.log|\
        state.db|state.db-wal|state.db-shm|logs|installs)
            continue ;;
    esac
    [ -e "$home/$name" ] || ln -s "$p" "$home/$name"
done

# Optional per-session overlay (HERMES_SESSION_OVERLAY, e.g. from `run.sh --env` +
# `--mount`): lets an orchestrator add plugins and config for one session without touching
# the shared home (whose config is read-only in the sandbox anyway). Agent-Fleet uses it
# for Orca's status plugin.
#   <overlay>/plugins/<name>/  linked into the session's plugins dir, next to the shared
#                              ones (an overlay plugin wins on a name clash)
#   <overlay>/config.yaml      merged into a session copy of the shared config.yaml:
#                              mappings recursively, lists by appending missing items,
#                              anything else replaced. Comments in the shared file survive.
overlay="${HERMES_SESSION_OVERLAY:-}"
if [ -n "$overlay" ] && [ -d "$overlay" ]; then
    if [ -d "$overlay/plugins" ]; then
        [ -L "$home/plugins" ] && rm -f "$home/plugins"
        mkdir -p "$home/plugins"
        for p in "$shared/plugins"/* "$overlay/plugins"/*; do
            [ -e "$p" ] || continue
            ln -sfn "$p" "$home/plugins/${p##*/}"
        done
    fi
    if [ -f "$overlay/config.yaml" ]; then
        rm -f "$home/config.yaml"
        # ruamel.yaml (round-trip, keeps comments) from the image's mitmproxy venv - Hermes'
        # own YAML library lives in its per-session installs/, which isn't prepared yet.
        /opt/mitmproxy/bin/python3 -I - "$shared/config.yaml" "$overlay/config.yaml" "$home/config.yaml" <<'PY'
import os, sys
from ruamel.yaml import YAML

def merge(base, extra):
    if isinstance(base, dict) and isinstance(extra, dict):
        for k, v in extra.items():
            base[k] = merge(base[k], v) if k in base else v
        return base
    if isinstance(base, list) and isinstance(extra, list):
        base.extend(v for v in extra if v not in base)
        return base
    return extra

shared, extra, out = sys.argv[1:4]
yaml = YAML()
base = None
if os.path.isfile(shared):
    with open(shared, encoding="utf-8") as f:
        base = yaml.load(f)
with open(extra, encoding="utf-8") as f:
    add = yaml.load(f) or {}
merged = merge(base if base is not None else {}, add)
with open(out, "w", encoding="utf-8") as f:
    yaml.dump(merged, f)
os.chmod(out, 0o600)
PY
    fi
fi

HERMES_HOME="$home"
export HERMES_HOME
exec /opt/hermes/hermes-agent/.hermes/bin/hermes "$@"
