#!/bin/sh
# Starts Claude Code with its own Bash sandbox (bubblewrap + a filtering proxy) switched
# on, on top of the container. harness.conf's `sandboxed_command`, i.e. what
# entrypoint.sh runs for `run.sh --bash-sandbox`. Installed to /usr/local/bin by
# install.sh. Arguments are passed through to claude.
#
# Why a second layer: the container proxy only filters what honors the proxy env vars, so a Bash
# command that ignores them (curl --noproxy, raw sockets) reaches the network directly,
# and the login token in ~/.claude/.credentials.json is plain readable by any command.
# Inside Claude Code's sandbox every Bash command gets its own network namespace with
# Claude Code's proxy as the only way out, and the paths below can't be read at all.
# File tools and MCP servers aren't sandboxed by it; the permission rules below cover
# the file tools.
#
# The settings are generated per session rather than baked in, so they follow this
# session's egress allowlist (including a --allow-list override) and the variables
# passed in with run.sh --env-file. Passed via --settings, not ~/.claude/settings.json,
# so the host's native claude is unaffected (same reason as --permission-mode auto in
# harness.conf), and so allowUnsandboxedCommands: false can't be undone by a project's
# .claude/settings.json.
set -eu

settings_dir=/tmp/agentcontainer
settings="$settings_dir/claude-sandbox-settings.json"
mkdir -p "$settings_dir"
rm -f "$settings"

# Normal mode: Claude Code mounts a fresh /proc in every sandboxed command, and its
# seccomp helper (apply-seccomp, which blocks Unix sockets) mounts one more inside that.
# Under sysbox the kernel refuses a fresh /proc (sysbox overmounts parts of the
# container's own), so neither can work there. Nested mode instead:
# - enableWeakerNestedSandbox: bind the container's /proc instead of a fresh one. Sysbox
#   only allows that bind for a process with its own ipc/uts/cgroup namespaces too,
#   which Claude Code doesn't create - bwrap-sysbox-shim adds them when
#   AGENTCONTAINER_BWRAP_EXTRA_NS=1 (exported below, so Claude Code's bwrap calls see it).
# - allowAllUnixSockets: the only setting that skips apply-seccomp. Unix sockets are
#   then reachable by path, so the root-equivalent ones (the nested dockerd/containerd)
#   are denied as files instead, below; the network namespace already keeps abstract
#   sockets apart.
# - sandboxed commands may create user namespaces (blocking that also needs
#   apply-seccomp or a fresh /proc). The mounts bwrap sets up are locked in any such
#   namespace, so this can't unmask the denied files or make read-only paths writable.
# KNOWN LIMITATION in nested mode: sandboxed commands see the container's /proc and run
# as the same UID as claude and its MCP servers, so /proc/<pid>/environ of those
# processes is readable from sandboxed Bash. The credentials.envVars deny below only
# strips the variables from the commands' own environment, it cannot hide them there -
# --env-file secrets are exposed to sandboxed shell commands in nested (sysbox) mode.
# Normal mode is unaffected: its fresh /proc hides the other processes outright. No
# cheap fix (hidepid isn't something bwrap can set on that mount).
# Both probes mirror the namespaces and /proc mount Claude Code itself uses, so a
# probe that passes means its commands will start. Neither working -> refuse: a session
# the user asked to be sandboxed must not silently run without it.
probe() {
  bwrap --new-session --die-with-parent --unshare-net --ro-bind / / --dev /dev \
    --unshare-pid --unshare-user "$@" true 2>/dev/null
}
nested=false
if probe --proc /proc; then
  echo "claude-sandboxed: Bash sandbox on" >&2
elif AGENTCONTAINER_BWRAP_EXTRA_NS=1 probe --bind /proc /proc; then
  nested=true
  export AGENTCONTAINER_BWRAP_EXTRA_NS=1
  echo "claude-sandboxed: Bash sandbox on (nested mode for sysbox, see README)" >&2
else
  echo "claude-sandboxed: bubblewrap doesn't work in this container, refusing to start without the Bash sandbox" >&2
  echo "claude-sandboxed: start with run.sh --no-bash-sandbox, or check: bwrap --unshare-user --unshare-pid --ro-bind / / --proc /proc true" >&2
  exit 1
fi

# The allowlist (see image/inspect-proxy.py) -> allowedDomains. A leading "." means the
# domain and every subdomain, so it becomes both "x.com" and "*.x.com". Ports are
# dropped: the sandbox filters by host only, the proxy addon still checks the port.
# Same entry forms as the addon's _split_port(): "[v6]:port" -> v6 (brackets off), a bare
# IPv6 address/CIDR (several colons) stays whole, only a single-colon "host:port" loses
# its port.
domains=$(sed -E 's/\r$//; s/#.*//; s/[[:space:]]//g; s/^\[([^]]*)\](:[0-9]+)?$/\1/; /^[^:]+:[0-9]+$/s/:[0-9]+$//' /etc/agentcontainer/allowed-hosts.txt \
  | grep -v '^$' | sort -u \
  | jq -R -s 'split("\n") | map(select(length > 0)) | map(if startswith(".") then (.[1:], "*" + .) else . end) | unique')

# What the user deliberately handed this session (set by run.sh/entrypoint.sh, reserved
# names an env file can't set):
# - AGENTCONTAINER_RW_MOUNTS: container paths of the read-write --mount/EXTRA_MOUNTS
#   entries, ':'-separated. Sandboxed commands may only write in $PWD otherwise; these
#   go to allowWrite (and additionalDirectories, so the file tools work there without
#   prompts too).
# - AGENTCONTAINER_DOCKER=host|nested: --allow-container / --with-docker. Then sandboxed
#   commands may use the Docker socket: the socket paths aren't denied, Unix sockets are
#   allowed (allowAllUnixSockets, which also skips the seccomp helper - not the per-path
#   allowUnixSockets: seccomp can't filter connect() by path, so on Linux that list
#   isn't something to rely on) and ~/.docker (container-local,
#   the CLI's config/buildx state) is writable. A Docker socket is root over whatever
#   runs the daemon, so with it the Bash sandbox no longer contains a determined command
#   - which is what those flags already mean, and why they're opt-in.
rw_mounts=$(printf '%s' "${AGENTCONTAINER_RW_MOUNTS:-}" \
  | jq -R -s 'split(":") | map(select(startswith("/"))) | unique')
docker=false
case "${AGENTCONTAINER_DOCKER:-}" in
  host|nested)
    docker=true
    mkdir -p "$HOME/.docker"
    echo "claude-sandboxed: Docker socket allowed in sandboxed commands (${AGENTCONTAINER_DOCKER} daemon)" >&2
    ;;
esac
if [ "$rw_mounts" != "[]" ]; then
  echo "claude-sandboxed: sandboxed commands may also write to: $(printf '%s' "$rw_mounts" | jq -r 'join(" ")')" >&2
fi

# Variables from run.sh --env-file (validated there and in entrypoint.sh): meant for MCP
# servers, which Claude Code starts outside the sandbox, so Bash doesn't need them.
# run.sh --env values stay visible (they aren't secrets: an orchestrator's session info,
# e.g. Orca's chat folder). An older run.sh doesn't tell them apart - hide all then.
env_vars=$(printf '%s' "${AGENTCONTAINER_SECRET_ENV_KEYS-${AGENTCONTAINER_ENV_KEYS:-}}" \
  | jq -R -s 'split(",") | map(select(length > 0)) | map({name: ., mode: "deny"})')

jq -n \
  --argjson domains "$domains" \
  --argjson env_vars "$env_vars" \
  --argjson nested "$nested" \
  --argjson docker "$docker" \
  --argjson rw_mounts "$rw_mounts" \
  --arg settings_dir "$settings_dir" \
  '{
    sandbox: ({
      enabled: true,
      failIfUnavailable: true,
      allowUnsandboxedCommands: false,
      enableWeakerNestedSandbox: $nested,
      filesystem: ({
        # The Docker/containerd sockets too, in both modes, unless the session was
        # given Docker on purpose (see above): root on the nested dockerd means a
        # container with all files of this one mounted and its own network. Seccomp
        # already blocks Unix sockets in normal mode; this also covers nested.
        # ~/.claude.json itself stays readable (MCP tokens belong in the env file, as
        # ${VAR}), but its backups (~/.claude.json.*, ~/.claude/backups) can predate that.
        denyRead: (["~/.claude.json.*", "~/.claude/.credentials.json",
                    "~/.claude/backups"]
                   + (if $docker then [] else ["/run/docker.sock", "/run/docker", "/run/containerd"] end)),
        denyWrite: [$settings_dir]
      } + (if ($rw_mounts | length) > 0 or $docker
           then { allowWrite: ($rw_mounts + (if $docker then ["~/.docker"] else [] end)) }
           else {} end)),
      network: ({ allowedDomains: $domains } + (if $nested or $docker then { allowAllUnixSockets: true } else {} end))
    } + (if ($env_vars | length) > 0 then { credentials: { envVars: $env_vars } } else {} end)),
    permissions: ((if ($rw_mounts | length) > 0 then { additionalDirectories: $rw_mounts } else {} end) + {
      deny: [
        "Read(~/.claude.json.*)",
        "Read(~/.claude/.credentials.json)",
        "Read(~/.claude/backups/**)",
        "Edit(/\($settings_dir)/**)",
        # Project-level settings live in $PWD, which is writable by design, and the
        # ro mounts cannot cover them. Claude Code trusts them on *native* host runs
        # in this same folder later (hooks, MCP servers) - the exact vector the ro
        # config mounts exist for, so deny the writes here. Deny rules merge and
        # win, and these come from --settings, so a project settings file cannot
        # undo them. Legitimate config edits go through the host-side claude or a
        # session started without the sandbox. Not covered (yet): project
        # .claude/commands|agents|hooks|skills subdirs, which are also executed -
        # blocking those outright breaks normal work, left to the permission mode.
        "Edit(./.claude/settings.json)",
        "Edit(./.claude/settings.local.json)",
        "Edit(./.mcp.json)"
      ]
    })
  }' > "$settings"
chmod 444 "$settings"

exec claude --settings "$settings" "$@"
