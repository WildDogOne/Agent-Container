# Optional, per-machine settings for run.sh. Copy this file to config/run.local.sh
# (gitignored - never committed, since the paths here are personal to whatever host
# you're running on) and edit it. run.sh sources it automatically if present and just
# skips it if not, so this is safe to leave unconfigured.

# Harness to run when no --harness is passed (default: claude). See harnesses/.
# HARNESS=claude

# Extra mounts beyond $PWD and the harness's own state.
#
# Each entry is one `docker run -v` argument, host:container[:ro]. Same path on both
# sides keeps things simple but isn't required - unlike $PWD, these don't need to line
# up with anything the container already expects.

EXTRA_MOUNTS=(
  # "$HOME/Obsidian:$HOME/Obsidian"
)

# More paths (relative to $HOME) to keep read-only unless --allow-config, on top of the
# harness's own `config` list in harness.conf - e.g. a statusline script your Claude
# Code settings point at:
# EXTRA_CONFIG_RO_PATHS=(.claude/statusline.sh)

# UID/GID that dev takes inside the container, so files it writes to the mounts are
# owned by that user on the host. Unset = automatic: your own UID/GID, or no remap
# (dev stays 1000:1000) as root, under rootless Docker or under Podman. Set a number
# to override the detection, or "off" to never remap. CONTAINER_GID defaults to your
# own GID and only applies together with CONTAINER_UID.
# CONTAINER_UID=1234
# CONTAINER_GID=1234

# Start every session as if --with-docker was passed: a nested Docker daemon inside the
# container (with --privileged, or the sysbox-runc runtime if this host has it
# registered). Without it there is no dockerd and no --privileged at all. See README.md.
# WITH_DOCKER=1

# Turn the Bash sandbox off: the harness's plain `command` instead of its
# sandboxed_command (for Claude Code: no bubblewrap sandbox around its shell commands).
# The sandbox is ON by default for harnesses that define one; 1 is the default and only
# 0 changes anything. See README.md.
# BASH_SANDBOX=0

# Docker env file passed into every session (--env-file overrides it), e.g. tokens your
# MCP servers reference as ${VAR} instead of keeping them in ~/.claude.json. Keep it
# outside the repo and chmod 600. See README.md. ~/.config/agentcontainer.env is used
# without this if it exists; set a different path here, or off to pass none.
# ENV_FILE="$HOME/.config/agentcontainer.env"

# Save every session's squid logs (access, cache, stderr) to the host instead of
# letting them die with the container: a per-session directory under
# ~/.local/state/agentcontainer/logs/<timestamp>-<harness>/ gets mirrored into by
# entrypoint.sh. Set SQUID_LOG_DIR to keep them somewhere else. --squid-logs enables
# this for one session, --no-squid-logs disables it even with SQUID_LOGS=1 set here.
# See README.md.
# SQUID_LOGS=1
# SQUID_LOG_DIR="$HOME/Logs/agentcontainer"
