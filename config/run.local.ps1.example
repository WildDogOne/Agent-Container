# Optional, per-machine settings for run.ps1 - the Windows counterpart of run.local.sh
# (see run.local.sh.example for the reasoning). Copy this file to config\run.local.ps1
# (gitignored) and edit it; run.ps1 dot-sources it if present.

# Harness to run when no --harness is passed (default: claude). See harnesses\.
# $HARNESS = 'claude'

# Each EXTRA_MOUNTS entry is host[:container][:ro], with a Windows host path. Without a
# container path it's mounted at the translated path (C:\data -> /c/data).

$EXTRA_MOUNTS = @(
  # "$env:USERPROFILE\Obsidian"
  # 'D:\datasets:/data:ro'
)

# More paths (relative to %USERPROFILE%) to keep read-only unless --allow-config, on
# top of the harness's own `config` list in harness.conf (see run.sh):
# $EXTRA_CONFIG_RO_PATHS += '.claude/statusline.ps1'

# No UID/GID remap by default on Windows (see run.ps1). Force one with:
# $CONTAINER_UID = '1000'
# $CONTAINER_GID = '1000'

# Start every session as if --with-docker was passed (nested dockerd, --privileged;
# see run.local.sh.example):
# $WITH_DOCKER = '1'

# Turn the Bash sandbox off (it's ON by default for harnesses that define a
# sandboxed_command; see run.local.sh.example):
# $BASH_SANDBOX = '0'

# Docker env file passed into every session (--env-file overrides it). Defaults to
# %USERPROFILE%\.config\agentcontainer.env if it exists; 'off' passes none:
# $ENV_FILE = "$env:USERPROFILE\.config\agentcontainer.env"

# Save every session's squid logs (access, cache, stderr) to the host instead of
# letting them die with the container: a per-session directory under
# %LOCALAPPDATA%\agentcontainer\logs\<timestamp>-<harness>\ gets mirrored into by
# entrypoint.sh. Set $SQUID_LOG_DIR to keep them somewhere else. --squid-logs enables
# this for one session, --no-squid-logs disables it even with $SQUID_LOGS = 1 set here.
# See README.md.
# $SQUID_LOGS = '1'
# $SQUID_LOG_DIR = "$env:USERPROFILE\Logs\agentcontainer"
